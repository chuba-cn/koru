# Matches the CI Postgres service. Locally, point this at your own
# apps/api/.env credentials instead — the user/password here won't match
# your dev Postgres container.
DATABASE_URL="postgresql://koru:koru@localhost:5432/koru_test?schema=public"
BETTER_AUTH_SECRET="ci-only-value-not-a-real-secret-0000000000="
BETTER_AUTH_URL="http://localhost:3001"
GOOGLE_CLIENT_ID="test-google-client-id"
GOOGLE_CLIENT_SECRET="test-google-client-secret"
WEB_ORIGIN="http://localhost:4000"

# Kept blank rather than removed, so ConsoleMailSender (the test helpers'
# getLastEmailLink depend on it) stays the mail sender by default.
RESEND_API_KEY=""
RESEND_WEBHOOK_SECRET="whsec_a29ydS1lMmUtdGVzdC13ZWJob29rLXNlY3JldC0zMmJ5dGVzISE="
SMTP_HOST=""
SMTP_PORT=""
MAIL_FROM="test@example.test"

# db 1, not 0: e2e obliterates the email queue on every test, and db 0 is
# what a locally running `pnpm dev` uses. Same host is fine for CI, where
# Redis is a throwaway per-job service container.
REDIS_URL="redis://localhost:6379/1"

# e2e tests call the outbox relay directly and assert exact before/after
# state, a real 1s background tick would race them. Production never sets
# this; see docs/architecture/transactional-outbox-and-relay.md.
RELAY_SCHEDULE_ENABLED="false"

SUPPORT_EMAIL="support@koru.com"
SUPPORT_PHONE="+234 709 478 7715"
LOGO_URL="https://koru.ng/logo.png"

# The e2e suite overrides PAYMENT_GATEWAY with a fake for network calls, but
# PaystackAdapter is still constructed for real (verifySignature/parseWebhook
# stay real, proving the actual production code path), module-scope
# requireEnv calls need a value even though no real Paystack call happens.
PAYSTACK_SECRET_KEY="sk_test_ci_only_value_never_calls_paystack"
PAYSTACK_PLACEHOLDER_EMAIL_DOMAIN="giving.koru.ng"

# e2e tests call the expiry sweep directly and assert exact before/after
# state, a real 60s background tick would race them. Production never sets
# this.
PAYMENT_SWEEP_SCHEDULE_ENABLED="false"

# Pepper for the one-way hash that detects a bank account registered twice.
# Any long random string. Changing it makes existing hashes unmatchable.
SETTLEMENT_ACCOUNT_HASH_PEPPER=dev-only-change-me
