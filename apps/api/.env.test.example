# Matches the CI Postgres service. Locally, point this at your own
# apps/api/.env credentials instead — the user/password here won't match
# your dev Postgres container.
DATABASE_URL="postgresql://koru:koru@localhost:5432/koru_test?schema=public"
BETTER_AUTH_SECRET="ci-only-value-not-a-real-secret-0000000000="
BETTER_AUTH_URL="http://localhost:3001"
GOOGLE_CLIENT_ID="test-google-client-id"
GOOGLE_CLIENT_SECRET="test-google-client-secret"
WEB_ORIGIN="http://localhost:4000"

# Kept blank rather than removed, so ConsoleMailSender (the test helpers'
# getLastEmailLink depend on it) stays the mail sender by default. #102 closed
# the leak these used to guard against — a developer's own apps/api/.env can
# no longer reach an e2e run at all — so this is just an explicit default now,
# not a required enumeration.
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT=""
MAIL_FROM="test@example.test"

# db 1, not 0: e2e obliterates the email queue on every test, and db 0 is
# what a locally running `pnpm dev` uses. Same host is fine for CI, where
# Redis is a throwaway per-job service container.
REDIS_URL="redis://localhost:6379/1"
