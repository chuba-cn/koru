// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum StaffRole {
  super_admin
  regional_admin
  branch_admin
  finance
  recorder
}

enum ScopeType {
  region
  branch
}

enum CampaignScopeType {
  church
  region
  branch
}

enum CampaignStatus {
  draft
  active
  paused
  completed
  archived
}

enum PledgeCadence {
  none
  weekly
  monthly
  payday
  custom
}

enum PledgeStatus {
  active
  fulfilled
  cancelled
}

enum PledgeSource {
  self
  admin
  imported
}

enum PaymentChannel {
  paystack_transfer
  cash
  pos
  imported
}

enum EmailCategory {
  staff_invite
  staff_removed
  church_welcome
  payment_confirmation
  campaign_broadcast
}

enum EmailDeliveryStatus {
  queued
  sent
  delivered
  bounced
  complained
  failed
}

enum WebhookStatus {
  received
  processed
  ignored
  failed
}

enum DonationIntentStatus {
  pending
  processing
  succeeded
  failed
  expired
  cancelled
}

enum PaymentAttemptStatus {
  pending
  processing
  succeeded
  failed
  expired
}

enum PaymentState {
  settled
  refunded
  reversed
}

enum LedgerAccount {
  gateway_clearing
  campaign_giving
  fees
  settlement_payout
  refunds
  cash_on_hand
}

enum LedgerEntryType {
  debit
  credit
}

enum DomainEventType {
  donation_intent_created
  payment_attempt_succeeded
  payment_settled
  refund_requested
  refund_processed
}

enum RefundStatus {
  pending
  approved
  rejected
  processed
}

enum CashApprovalStatus {
  pending
  approved
  rejected
}

model Church {
  id                  String   @id @default(uuid())
  name                String
  timezone            String   @default("Africa/Lagos")
  paystackBusinessRef String?
  createdAt           DateTime @default(now())

  regions               Region[]
  branches              Branch[]
  members               Member[]
  staff                 Staff[]
  settlementAccounts    SettlementAccount[]
  campaigns             Campaign[]
  emailLogs             EmailLog[]
  donationIntents       DonationIntent[]
  paymentAttempts       PaymentAttempt[]
  payments              Payment[]
  ledgerTransactions    LedgerTransaction[]
  ledgerEntries         LedgerEntry[]
  domainEvents          DomainEvent[]
  refundRequests        RefundRequest[]
  auditLogs             AuditLog[]
  campaignBalances      CampaignBalance[]
  memberGivingSummaries MemberGivingSummary[]
}

model Region {
  id        String   @id @default(uuid())
  churchId  String
  name      String
  state     String
  createdAt DateTime @default(now())

  church   Church   @relation(fields: [churchId], references: [id])
  branches Branch[]

  @@unique([churchId, name])
}

model Branch {
  id        String   @id @default(uuid())
  churchId  String
  regionId  String?
  name      String
  address   String?
  createdAt DateTime @default(now())

  church             Church              @relation(fields: [churchId], references: [id], onDelete: Cascade)
  region             Region?             @relation(fields: [regionId], references: [id], onDelete: SetNull)
  members            Member[]
  settlementAccounts SettlementAccount[]
  donationIntents    DonationIntent[]
  paymentAttempts    PaymentAttempt[]
  payments           Payment[]
  ledgerEntries      LedgerEntry[]
  refundRequests     RefundRequest[]

  @@unique([churchId, name])
  @@index([regionId])
}

model Member {
  id                String     @id @default(uuid())
  churchId          String
  homeBranchId      String?
  fullName          String
  phone             String
  email             String?
  pledges           Pledge[]
  payments          Payment[]
  emailLogsReceived EmailLog[]
  createdAt         DateTime   @default(now())

  church          Church               @relation(fields: [churchId], references: [id], onDelete: Cascade)
  homeBranch      Branch?              @relation(fields: [homeBranchId], references: [id], onDelete: SetNull)
  userId          String?
  user            User?                @relation("MemberUser", fields: [userId], references: [id], onDelete: SetNull)
  donationIntents DonationIntent[]
  givingSummary   MemberGivingSummary?

  @@unique([churchId, phone])
  @@index([userId])
  @@index([homeBranchId])
}

model Staff {
  id               String    @id @default(uuid())
  churchId         String
  fullName         String
  email            String
  passwordHash     String?
  role             StaffRole
  paymentsRecorded Payment[] @relation("PaymentsRecorded")
  createdAt        DateTime  @default(now())

  church            Church           @relation(fields: [churchId], references: [id], onDelete: Cascade)
  scopes            StaffScope[]
  invites           StaffInvite[]
  campaignsCreated  Campaign[]
  emailLogsReceived EmailLog[]
  attemptsRecorded  PaymentAttempt[] @relation("PaymentAttemptsRecorded")
  cashApprovals     PaymentAttempt[] @relation("PaymentAttemptCashApprovals")
  refundsRequested  RefundRequest[]  @relation("RefundsRequested")
  refundsApproved   RefundRequest[]  @relation("RefundsApproved")
  auditLogs         AuditLog[]
  userId            String?          @unique
  user              User?            @relation("StaffUser", fields: [userId], references: [id], onDelete: SetNull)

  @@unique([churchId, email])
  @@index([churchId, fullName, id])
}

model StaffScope {
  id         String    @id @default(uuid())
  staffId    String
  scopeType  ScopeType
  scopeRefId String

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
}

model StaffInvite {
  id         String    @id @default(ulid())
  staffId    String
  tokenHash  String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  // Set when accept() provisioned a login. An invite with acceptedAt set but
  // this still null means the flow died mid-way; see ADR-0012.
  provisionedUserId String?

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
}

model SettlementAccount {
  id                     String   @id @default(uuid())
  churchId               String
  branchId               String?
  label                  String
  paystackSubaccountCode String?
  bankName               String?
  accountNumberMasked    String?
  createdAt              DateTime @default(now())

  church    Church     @relation(fields: [churchId], references: [id], onDelete: Cascade)
  branch    Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  campaigns Campaign[]

  @@index([churchId, label, id])
  @@index([branchId])
}

model Campaign {
  id                  String            @id @default(uuid())
  churchId            String
  title               String
  description         String?
  scopeType           CampaignScopeType
  scopeRefId          String?
  settlementAccountId String
  targetAmountKobo    BigInt
  currency            String            @default("NGN")
  startDate           DateTime?
  endDate             DateTime?
  status              CampaignStatus    @default(draft)
  pledges             Pledge[]
  payments            Payment[]

  createdById String?
  createdAt   DateTime @default(now())

  church            Church            @relation(fields: [churchId], references: [id], onDelete: Cascade)
  settlementAccount SettlementAccount @relation(fields: [settlementAccountId], references: [id])
  createdBy         Staff?            @relation(fields: [createdById], references: [id], onDelete: SetNull)

  donationIntents DonationIntent[]
  ledgerEntries   LedgerEntry[]
  balance         CampaignBalance?

  @@index([churchId])
  @@index([settlementAccountId])
  @@index([scopeType, scopeRefId])
}

model Pledge {
  id               String        @id @default(uuid())
  campaignId       String
  memberId         String
  pledgeAmountKobo BigInt
  cadence          PledgeCadence @default(none)
  status           PledgeStatus  @default(active)
  source           PledgeSource  @default(self)
  createdAt        DateTime      @default(now())

  campaign        Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  member          Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  payments        Payment[]
  donationIntents DonationIntent[]

  @@index([campaignId])
  @@index([memberId])
}

model DonationIntent {
  id             String               @id @default(uuid())
  churchId       String
  branchId       String?
  campaignId     String
  memberId       String
  pledgeId       String?
  amountKobo     BigInt
  idempotencyKey String
  status         DonationIntentStatus @default(pending)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  church   Church           @relation(fields: [churchId], references: [id], onDelete: Cascade)
  branch   Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  // Restrict, not Cascade: deleting a Campaign must never take real giving
  // history with it. Per ADR-0016, that history stays visible and provable —
  // a Campaign with intents against it isn't deletable at all.
  campaign Campaign         @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  member   Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  pledge   Pledge?          @relation(fields: [pledgeId], references: [id], onDelete: SetNull)
  attempts PaymentAttempt[]

  @@unique([churchId, idempotencyKey])
  @@index([churchId, status])
  @@index([campaignId])
  @@index([memberId])
}

model PaymentAttempt {
  id                   String               @id @default(uuid())
  churchId             String
  branchId             String?
  donationIntentId     String
  channel              PaymentChannel
  status               PaymentAttemptStatus @default(pending)
  providerReference    String?              @unique
  virtualAccountNumber String?
  virtualAccountBank   String?
  amountKobo           BigInt
  expiresAt            DateTime?
  cashApprovalStatus   CashApprovalStatus?
  cashApprovedById     String?
  recordedById         String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  church         Church         @relation(fields: [churchId], references: [id], onDelete: Cascade)
  branch         Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  donationIntent DonationIntent @relation(fields: [donationIntentId], references: [id], onDelete: Cascade)
  cashApprovedBy Staff?         @relation("PaymentAttemptCashApprovals", fields: [cashApprovedById], references: [id], onDelete: SetNull)
  recordedBy     Staff?         @relation("PaymentAttemptsRecorded", fields: [recordedById], references: [id], onDelete: SetNull)
  payment        Payment?

  @@index([churchId, status, createdAt])
  @@index([donationIntentId])
}

model Payment {
  id                   String         @id @default(uuid())
  churchId             String
  branchId             String?
  campaignId           String
  memberId             String?
  pledgeId             String?
  paymentAttemptId     String?        @unique
  amountKobo           BigInt
  channel              PaymentChannel
  state                PaymentState   @default(settled)
  paystackReference    String?        @unique
  virtualAccountNumber String?
  virtualAccountBank   String?
  recordedById         String?
  paidAt               DateTime
  createdAt            DateTime       @default(now())

  church         Church          @relation(fields: [churchId], references: [id], onDelete: Cascade)
  branch         Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  // Restrict, not Cascade: a settled Payment is immutable per ADR-0016 — its
  // Campaign can never be deleted out from under it.
  campaign       Campaign        @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  member         Member?         @relation(fields: [memberId], references: [id], onDelete: SetNull)
  pledge         Pledge?         @relation(fields: [pledgeId], references: [id], onDelete: SetNull)
  paymentAttempt PaymentAttempt? @relation(fields: [paymentAttemptId], references: [id], onDelete: SetNull)
  recordedBy     Staff?          @relation("PaymentsRecorded", fields: [recordedById], references: [id], onDelete: SetNull)
  refundRequests RefundRequest[]

  @@index([churchId])
  @@index([campaignId])
  @@index([memberId])
  @@index([pledgeId])
}

model LedgerTransaction {
  id        String   @id @default(uuid())
  churchId  String
  reason    String
  createdAt DateTime @default(now())

  church  Church        @relation(fields: [churchId], references: [id], onDelete: Cascade)
  entries LedgerEntry[]

  @@index([churchId, createdAt])
}

model LedgerEntry {
  id            String          @id @default(uuid())
  transactionId String
  churchId      String
  branchId      String?
  campaignId    String?
  account       LedgerAccount
  entryType     LedgerEntryType
  amountKobo    BigInt
  dedupeKey     String          @unique
  createdAt     DateTime        @default(now())

  transaction LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  church      Church            @relation(fields: [churchId], references: [id], onDelete: Cascade)
  branch      Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  campaign    Campaign?         @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([churchId, createdAt])
  @@index([campaignId, entryType])
}

model DomainEvent {
  id          String          @id @default(uuid())
  churchId    String
  type        DomainEventType
  payload     Json
  publishedAt DateTime?
  createdAt   DateTime        @default(now())

  church Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  @@index([churchId, createdAt])
}

model RefundRequest {
  id            String       @id @default(uuid())
  churchId      String
  branchId      String?
  paymentId     String
  amountKobo    BigInt
  reason        String
  status        RefundStatus @default(pending)
  requestedById String?
  approvedById  String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  church      Church  @relation(fields: [churchId], references: [id], onDelete: Cascade)
  branch      Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  payment     Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  // SetNull, not Restrict: a Staff member who ever requested a refund must
  // still be removable (StaffService.remove hard-deletes). Who requested it
  // is preserved in AuditLog, which is the durable record for this fact —
  // this FK is a convenience join, not the fact's only home.
  requestedBy Staff?  @relation("RefundsRequested", fields: [requestedById], references: [id], onDelete: SetNull)
  approvedBy  Staff?  @relation("RefundsApproved", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([churchId, status])
  @@index([paymentId])
}

model AuditLog {
  id           String   @id @default(uuid())
  churchId     String
  actorStaffId String?
  action       String
  entityType   String
  entityId     String
  metadata     Json?
  createdAt    DateTime @default(now())

  church     Church @relation(fields: [churchId], references: [id], onDelete: Cascade)
  actorStaff Staff? @relation(fields: [actorStaffId], references: [id], onDelete: SetNull)

  @@index([churchId, createdAt])
  @@index([entityType, entityId])
}

model CampaignBalance {
  campaignId        String   @id
  churchId          String
  totalRaisedKobo   BigInt   @default(0)
  totalRefundedKobo BigInt   @default(0)
  updatedAt         DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  church   Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)

  @@index([churchId])
}

model MemberGivingSummary {
  memberId       String    @id
  churchId       String
  totalGivenKobo BigInt    @default(0)
  lastGivingAt   DateTime?
  updatedAt      DateTime  @updatedAt

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  church Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  @@index([churchId])
}

model EmailLog {
  id                String              @id @default(uuid())
  churchId          String
  category          EmailCategory
  recipientEmail    String
  recipientStaffId  String?
  recipientMemberId String?
  subject           String
  renderedHtml      String
  providerName      String
  providerMessageId String?             @unique
  status            EmailDeliveryStatus @default(queued)
  failureReason     String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime            @default(now())

  church Church  @relation(fields: [churchId], references: [id], onDelete: Cascade)
  staff  Staff?  @relation(fields: [recipientStaffId], references: [id], onDelete: SetNull)
  member Member? @relation(fields: [recipientMemberId], references: [id], onDelete: SetNull)

  @@index([churchId])
  @@index([status])
}

model User {
  id                  String    @id
  name                String
  email               String
  emailVerified       Boolean   @default(false)
  image               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  sessions            Session[]
  accounts            Account[]
  phoneNumber         String?   @unique
  phoneNumberVerified Boolean   @default(false)
  // One login is staff at one church; members are a separate axis. See ADR-0010.
  staff               Staff?    @relation("StaffUser")
  members             Member[]  @relation("MemberUser")

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model WebhookEvent {
  id              String        @id @default(uuid())
  paystackEventId String        @unique
  type            String
  payload         Json
  churchId        String?
  signature       String
  rawBody         String
  status          WebhookStatus @default(received)
  receivedAt      DateTime      @default(now())
  processedAt     DateTime?
  createdAt       DateTime      @default(now())

  @@index([churchId])
}
