// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum StaffRole {
  super_admin
  regional_admin
  branch_admin
  finance
}

enum ScopeType {
  region
  branch
}

enum CampaignScopeType {
  church
  region
  branch
}

enum CampaignStatus {
  draft
  active
  paused
  completed
  archived
}

model Church {
  id                  String   @id @default(uuid())
  name                String
  timezone            String   @default("Africa/Lagos")
  paystackBusinessRef String?
  createdAt           DateTime @default(now())

  regions           Region[]
  branches          Branch[]
  members           Member[]
  staff             Staff[]
  settlementAccounts SettlementAccount[]
  campaigns         Campaign[]
}

model Region {
  id        String   @id @default(uuid())
  churchId  String
  name      String
  state     String
  createdAt DateTime @default(now())

  church   Church   @relation(fields: [churchId], references: [id])
  branches Branch[]

  @@index([churchId])
}

model Branch {
  id        String   @id @default(uuid())
  churchId  String
  regionId  String?
  name      String
  address   String?
  createdAt DateTime @default(now())

  church             Church              @relation(fields: [churchId], references: [id], onDelete: Cascade)
  region             Region?             @relation(fields: [regionId], references: [id], onDelete: SetNull)
  members            Member[]
  settlementAccounts SettlementAccount[]

  @@index([churchId])
  @@index([regionId])
}

model Member {
  id           String   @id @default(uuid())
  churchId     String
  homeBranchId String
  fullName     String
  phone        String
  email        String?
  createdAt    DateTime @default(now())

  church     Church @relation(fields: [churchId], references: [id], onDelete: Cascade)
  homeBranch Branch @relation(fields: [homeBranchId], references: [id])

  @@unique([churchId, phone])
  @@index([homeBranchId])
}

model Staff {
  id           String    @id @default(uuid())
  churchId     String
  fullName     String
  email        String
  passwordHash String
  role         StaffRole
  createdAt    DateTime  @default(now())

  church           Church       @relation(fields: [churchId], references: [id], onDelete: Cascade)
  scopes           StaffScope[]
  campaignsCreated Campaign[]

  @@unique([churchId, email])
}

model StaffScope {
  id         String    @id @default(uuid())
  staffId    String
  scopeType  ScopeType
  scopeRefId String

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
}

model SettlementAccount {
  id                     String   @id @default(uuid())
  churchId               String
  branchId               String?
  label                  String
  paystackSubaccountCode String?
  bankName               String?
  accountNumberMasked    String?
  createdAt              DateTime @default(now())

  church    Church     @relation(fields: [churchId], references: [id], onDelete: Cascade)
  branch    Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  campaigns Campaign[]

  @@index([churchId])
  @@index([branchId])
}

model Campaign {
  id                  String            @id @default(uuid())
  churchId            String
  title               String
  description         String?
  scopeType           CampaignScopeType
  scopeRefId          String?
  settlementAccountId String
  targetAmountKobo    BigInt
  currency            String            @default("NGN")
  startDate           DateTime?
  endDate             DateTime?
  status              CampaignStatus    @default(draft)

  createdById String?
  createdAt   DateTime @default(now())

  church            Church            @relation(fields: [churchId], references: [id], onDelete: Cascade)
  settlementAccount SettlementAccount @relation(fields: [settlementAccountId], references: [id])
  createdBy         Staff?            @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([churchId])
  @@index([settlementAccountId])
  @@index([scopeType, scopeRefId])
}
