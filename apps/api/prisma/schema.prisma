// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum StaffRole {
  super_admin
  regional_admin
  branch_admin
  finance
  recorder
}

enum ScopeType {
  region
  branch
}

enum CampaignScopeType {
  church
  region
  branch
}

enum CampaignStatus {
  draft
  active
  paused
  completed
  archived
}

enum PledgeCadence {
  none
  weekly
  monthly
  payday
  custom
}

enum PledgeStatus {
  active
  fulfilled
  cancelled
}

enum PledgeSource {
  self
  admin
  imported
}

enum PaymentChannel {
  paystack_transfer
  cash
  pos
  imported
}

enum PaymentStatus {
  pending
  success
  failed
  reversed
}

enum EmailCategory {
  staff_invite
  staff_removed
  church_welcome
  payment_confirmation
  campaign_broadcast
}

enum EmailDeliveryStatus {
  queued
  sent
  delivered
  bounced
  complained
  failed
}

enum WebhookStatus {
  received
  processed
  ignored
  failed
}

model Church {
  id                  String   @id @default(uuid())
  name                String
  timezone            String   @default("Africa/Lagos")
  paystackBusinessRef String?
  createdAt           DateTime @default(now())

  regions            Region[]
  branches           Branch[]
  members            Member[]
  staff              Staff[]
  settlementAccounts SettlementAccount[]
  campaigns          Campaign[]
  emailLogs          EmailLog[]
}

model Region {
  id        String   @id @default(uuid())
  churchId  String
  name      String
  state     String
  createdAt DateTime @default(now())

  church   Church   @relation(fields: [churchId], references: [id])
  branches Branch[]

  @@unique([churchId, name])
  @@index([churchId])
}

model Branch {
  id        String   @id @default(uuid())
  churchId  String
  regionId  String?
  name      String
  address   String?
  createdAt DateTime @default(now())

  church             Church              @relation(fields: [churchId], references: [id], onDelete: Cascade)
  region             Region?             @relation(fields: [regionId], references: [id], onDelete: SetNull)
  members            Member[]
  settlementAccounts SettlementAccount[]

  @@unique([churchId, name])
  @@index([churchId])
  @@index([regionId])
}

model Member {
  id                String     @id @default(uuid())
  churchId          String
  homeBranchId      String?
  fullName          String
  phone             String
  email             String?
  pledges           Pledge[]
  payments          Payment[]
  emailLogsReceived EmailLog[]
  createdAt         DateTime   @default(now())

  church     Church  @relation(fields: [churchId], references: [id], onDelete: Cascade)
  homeBranch Branch? @relation(fields: [homeBranchId], references: [id], onDelete: SetNull)
  userId     String?
  user       User?   @relation("MemberUser", fields: [userId], references: [id], onDelete: SetNull)

  @@unique([churchId, phone])
  @@index([userId])
  @@index([homeBranchId])
}

model Staff {
  id               String    @id @default(uuid())
  churchId         String
  fullName         String
  email            String
  passwordHash     String?
  role             StaffRole
  paymentsRecorded Payment[]
  createdAt        DateTime  @default(now())

  church            Church        @relation(fields: [churchId], references: [id], onDelete: Cascade)
  scopes            StaffScope[]
  invites           StaffInvite[]
  campaignsCreated  Campaign[]
  emailLogsReceived EmailLog[]
  userId            String?       @unique
  user              User?         @relation("StaffUser", fields: [userId], references: [id], onDelete: SetNull)

  @@unique([churchId, email])
}

model StaffScope {
  id         String    @id @default(uuid())
  staffId    String
  scopeType  ScopeType
  scopeRefId String

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
}

model StaffInvite {
  id         String    @id @default(ulid())
  staffId    String
  tokenHash  String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  // Set when accept() provisioned a login. An invite with acceptedAt set but
  // this still null means the flow died mid-way; see ADR-0012.
  provisionedUserId String?

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
}

model SettlementAccount {
  id                     String   @id @default(uuid())
  churchId               String
  branchId               String?
  label                  String
  paystackSubaccountCode String?
  bankName               String?
  accountNumberMasked    String?
  createdAt              DateTime @default(now())

  church    Church     @relation(fields: [churchId], references: [id], onDelete: Cascade)
  branch    Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  campaigns Campaign[]

  @@index([churchId])
  @@index([branchId])
}

model Campaign {
  id                  String            @id @default(uuid())
  churchId            String
  title               String
  description         String?
  scopeType           CampaignScopeType
  scopeRefId          String?
  settlementAccountId String
  targetAmountKobo    BigInt
  currency            String            @default("NGN")
  startDate           DateTime?
  endDate             DateTime?
  status              CampaignStatus    @default(draft)
  pledges             Pledge[]
  payments            Payment[]

  createdById String?
  createdAt   DateTime @default(now())

  church            Church            @relation(fields: [churchId], references: [id], onDelete: Cascade)
  settlementAccount SettlementAccount @relation(fields: [settlementAccountId], references: [id])
  createdBy         Staff?            @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([churchId])
  @@index([settlementAccountId])
  @@index([scopeType, scopeRefId])
}

model Pledge {
  id               String        @id @default(uuid())
  campaignId       String
  memberId         String
  pledgeAmountKobo BigInt
  cadence          PledgeCadence @default(none)
  status           PledgeStatus  @default(active)
  source           PledgeSource  @default(self)
  createdAt        DateTime      @default(now())

  campaign Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  member   Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([campaignId])
  @@index([memberId])
}

model Payment {
  id                   String         @id @default(uuid())
  campaignId           String
  memberId             String?
  pledgeId             String?
  amountKobo           BigInt
  channel              PaymentChannel
  status               PaymentStatus  @default(pending)
  paystackReference    String?        @unique
  virtualAccountNumber String?
  virtualAcoountBank   String?
  expiresAt            DateTime?
  recordedById         String?
  paidAt               DateTime?
  createdAt            DateTime       @default(now())

  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  member     Member?  @relation(fields: [memberId], references: [id], onDelete: SetNull)
  pledge     Pledge?  @relation(fields: [pledgeId], references: [id], onDelete: SetNull)
  recordedBy Staff?   @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([campaignId])
  @@index([memberId])
  @@index([pledgeId])
  @@index([status])
}

model EmailLog {
  id                String              @id @default(uuid())
  churchId          String
  category          EmailCategory
  recipientEmail    String
  recipientStaffId  String?
  recipientMemberId String?
  subject           String
  renderedHtml      String
  providerName      String
  providerMessageId String?             @unique
  status            EmailDeliveryStatus @default(queued)
  failureReason     String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime            @default(now())

  church Church  @relation(fields: [churchId], references: [id], onDelete: Cascade)
  staff  Staff?  @relation(fields: [recipientStaffId], references: [id], onDelete: SetNull)
  member Member? @relation(fields: [recipientMemberId], references: [id], onDelete: SetNull)

  @@index([churchId])
  @@index([status])
}

model User {
  id                  String    @id
  name                String
  email               String
  emailVerified       Boolean   @default(false)
  image               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  sessions            Session[]
  accounts            Account[]
  phoneNumber         String?   @unique
  phoneNumberVerified Boolean   @default(false)
  // One login is staff at one church; members are a separate axis. See ADR-0010.
  staff               Staff?    @relation("StaffUser")
  members             Member[]  @relation("MemberUser")

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model WebhookEvent {
  id              String        @default(uuid())
  paystackEventId String        @unique
  type            String
  payload         Json
  status          WebhookStatus @default(received)
  processedAt     DateTime?
  createdAt       DateTime      @default(now())
}
