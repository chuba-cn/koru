DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/koru?schema=public"
BETTER_AUTH_SECRET="generate-with: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3001"

# Origin(s) the frontend is served from. Better Auth checks this for CSRF/origin
# validation and for the OAuth callbackURL, so it must match the real frontend in
# every environment. Comma-separated if there is more than one.
WEB_ORIGIN="http://localhost:3000"

# Optional. Set both to enable Google sign-in, or neither to disable it.
# Setting only one is an error and the API will refuse to boot.
GOOGLE_CLIENT_ID="get-from-google-cloud-console"
GOOGLE_CLIENT_SECRET="get-from-google-cloud-console"