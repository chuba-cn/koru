DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/koru?schema=public"
BETTER_AUTH_SECRET="generate-with: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3001"

# Origin(s) the frontend is served from. Better Auth checks this for CSRF/origin
# validation and for the OAuth callbackURL, so it must match the real frontend in
# every environment. Comma-separated if there is more than one.
WEB_ORIGIN="http://localhost:3000"

# Optional. Set both to enable Google sign-in, or neither to disable it.
# Setting only one is an error and the API will refuse to boot.
GOOGLE_CLIENT_ID="get-from-google-cloud-console"
GOOGLE_CLIENT_SECRET="get-from-google-cloud-console"

# Optional. Set both to send real email via Resend, or neither to log to the
# console instead (ConsoleMailSender, dev/test only). Setting only one is an
# error and the API will refuse to boot.
RESEND_API_KEY="secret-resend-key"
RESEND_WEBHOOK_SECRET="secret-webhook-key"
MAIL_FROM="youremail@domain.com"

# Required. Every email send goes through the BullMQ queue, which needs Redis.
REDIS_URL="redis://localhost:6379"

# Optional. Point at a local Mailpit instance to inspect real rendered HTML
# emails during development (docker compose up mailpit, then
# http://localhost:8025). Setting only one of the pair is an error.
SMTP_HOST="localhost"
SMTP_PORT="1025"

# Shown in every outbound email's footer.
SUPPORT_EMAIL="chuba.dev@gmail.com"
SUPPORT_PHONE="+234 706 079 9114"

# Must be a real, public URL — an email cannot load a local file.
LOGO_URL="https://koru.ng/logo.png"